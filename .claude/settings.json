{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cmake:*)",
      "Bash(ctest:*)",
      "Bash(ninja:*)",
      "Bash(make:*)",
      "Bash(./build/ofdx_selftest*)",
      "Bash(./build/openfdtd_x*)",
      "Bash(QT_QPA_PLATFORM=offscreen ./build/ofdx_selftest:*)",
      "Bash(QT_QPA_PLATFORM=offscreen ctest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Read(./secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf /:*)"
    ]
  },
  "env": {
    "QT_QPA_PLATFORM": "offscreen"
  },
  "attribution": {
    "commit": true,
    "pr": true
  },
  "includeCoAuthoredBy": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-new-source.js"
          }
        ]
      }
    ]
  }
}
